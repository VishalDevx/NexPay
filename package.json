{
  "name": "nexpay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:push": "cd apps/api && npx prisma db push",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "seed:demo": "npm run seed:demo -w apps/api",
    "seed:golden": "npm run seed:golden -w apps/api",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e-report",
    "docker:e2e": "docker compose -f docker-compose.e2e.yml up --build -d && npx wait-on http://localhost:3000 && npx wait-on http://localhost:3001/api/v1/health && playwright test; docker compose -f docker-compose.e2e.yml down",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "wait-on": "^9.0.10"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
