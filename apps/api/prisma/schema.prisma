generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  SUSPENDED
  TERMINATED
  CLOSED
}

enum RiskCategory {
  LOW
  MEDIUM
  HIGH
  PROHIBITED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  PENDING_MERCHANT
  PENDING_INTERNAL
  RESOLVED
  CLOSED
}

enum TicketCategory {
  PAYMENT_FAILED
  SETTLEMENT_DELAYED
  REFUND_ISSUE
  WEBHOOK_ISSUE
  KYC_ISSUE
  DISPUTE_ISSUE
  ACCOUNT_SUSPENSION
  GENERAL
  BILLING
  TECHNICAL
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
}

enum IncidentStatus {
  DETECTED
  INVESTIGATING
  MITIGATING
  RESOLVED
  POSTMORTEM
  CLOSED
}

enum PlanTier {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  EXPIRED
}

enum SplitType {
  FIXED
  PERCENTAGE
  COMMISSION
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ApiKeyEnv {
  LIVE
  TEST
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  AUTHORIZED
  CAPTURED
  SETTLED
  FAILED
  REFUNDED
  DISPUTED
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum WalletTxnType {
  LOAD
  WITHDRAW
  TRANSFER_IN
  TRANSFER_OUT
  PAYMENT_IN
  PAYOUT
  FEE
  REFUND
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  RAISED
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  RESOLVED_MERCHANT_WON
  RESOLVED_MERCHANT_LOST
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTER
}

model Merchant {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  email                String         @unique
  passwordHash         String
  status               MerchantStatus @default(DRAFT)
  riskCategory         RiskCategory?  @default(LOW)
  baseCurrency         String         @default("INR")
  country              String?
  businessType         String?
  mccCode              String?
  expectedMonthlyVolume Decimal?      @db.Decimal(20, 4)
  averageTicketSize    Decimal?       @db.Decimal(20, 4)
  websiteUrl           String?
  refundPolicyUrl      String?
  termsUrl             String?
  businessDescription  String?
  incorporationDate    DateTime?
  taxId                String?
  kycStatus            KYCStatus      @default(NOT_SUBMITTED)
  kycDocuments         Json?
  kycSubmittedAt       DateTime?
  kycExpiryAt          DateTime?
  webhookSecret        String?
  emailVerified        Boolean        @default(false)
  totpSecret           String?
  totpEnabled          Boolean        @default(false)
  smsMfaEnabled        Boolean        @default(false)
  smsMfaPhone          String?
  backupCodes          Json?
  recoveryEmail        String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  payoutSchedule       Json?
  settingsJson         Json?
  brandingJson         Json?
  riskScore            Decimal?       @default(0) @db.Decimal(5, 2)
  rejectionReason      String?
  approvedAt           DateTime?
  approvedBy           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  apiKeys        ApiKey[]
  payments       Payment[]
  accounts       Account[]
  wallets        Wallet[]
  payouts        Payout[]
  disputes       Dispute[]
  webhooks       WebhookEndpoint[]
  idempotency    IdempotencyKey[]
  customers      Customer[]
  bankAccounts   BankAccount[]
  invoices       Invoice[]
  teamMembers    TeamMember[]
  uploads        Upload[]
  sessions       MerchantSession[]
  notificationPrefs NotificationPreference[]
  subMerchants   SubMerchant[]
  approvalHistory MerchantApproval[]
  reserveConfig  ReserveConfig?
  complianceNotes ComplianceNote[]
  supportTickets SupportTicket[]
  subscriptions  Subscription[]
  feeSchedules   FeeSchedule[]

  @@map("merchants")
}

model ApiKey {
  id        String     @id @default(uuid()) @db.Uuid
  merchantId String    @db.Uuid
  keyHash   String     @unique
  prefix    String
  env       ApiKeyEnv  @default(LIVE)
  scopes    Json       @default("[]")
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("api_keys")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  merchantId String  @db.Uuid
  email     String?
  name      String?
  phone     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payments Payment[]

  @@unique([merchantId, email])
  @@map("customers")
}

model Refund {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  amount    Decimal  @db.Decimal(20, 4)
  reason    String?
  status    String   @default("SUCCEEDED")
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  merchantId      String        @db.Uuid
  customerId      String?       @db.Uuid
  amount          Decimal       @db.Decimal(20, 4)
  amountRefunded  Decimal       @default(0) @db.Decimal(20, 4)
  currency        String        @default("INR")
  status          PaymentStatus @default(INITIATED)
  idempotencyKey  String?
  paymentMethod   Json?
  metadata        Json?
  fraudScore      Decimal?      @db.Decimal(5, 2)
  description     String?
  capturedAt      DateTime?
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  merchant      Merchant        @relation(fields: [merchantId], references: [id])
  customer      Customer?       @relation(fields: [customerId], references: [id])
  events        PaymentEvent[]
  ledgerEntries LedgerEntry[]
  fraudEvents   FraudEvent[]
  disputes      Dispute[]
  webhooks      WebhookDelivery[]
  payoutItems   PayoutItem[]
  refunds       Refund[]
  splitTransactions SplitTransaction[]
  settlementBatchItems SettlementBatchItem[]

  @@index([merchantId])
  @@index([idempotencyKey])
  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @db.Uuid
  fromStatus  PaymentStatus
  toStatus    PaymentStatus
  actor       String
  reason      String?
  createdAt   DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

model Account {
  id         String      @id @default(uuid()) @db.Uuid
  merchantId String      @db.Uuid
  type       AccountType
  currency   String
  name       String
  lastBalance Decimal    @default(0) @db.Decimal(20, 4)
  createdAt  DateTime    @default(now())

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([merchantId, type, currency])
  @@map("accounts")
}

model LedgerEntry {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @db.Uuid
  paymentId    String?   @db.Uuid
  type         EntryType
  amount       Decimal   @db.Decimal(20, 4)
  currency     String
  balanceAfter Decimal   @db.Decimal(20, 4)
  description  String?
  createdAt    DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([accountId])
  @@index([paymentId])
  @@index([createdAt])
  @@map("ledger_entries")
}

model Wallet {
  id               String    @id @default(uuid()) @db.Uuid
  merchantId       String    @db.Uuid
  currency         String
  redisBalanceKey  String    @unique
  lastReconciledAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  merchant Merchant    @relation(fields: [merchantId], references: [id])
  txns     WalletTxn[]

  @@unique([merchantId, currency])
  @@map("wallets")
}

model WalletTxn {
  id        String        @id @default(uuid()) @db.Uuid
  walletId  String        @db.Uuid
  type      WalletTxnType
  amount    Decimal       @db.Decimal(20, 4)
  refId     String?
  refType   String?
  createdAt DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@map("wallet_txns")
}

model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  merchantId   String       @db.Uuid
  amount       Decimal      @db.Decimal(20, 4)
  currency     String
  status       PayoutStatus @default(PENDING)
  scheduledFor DateTime?
  bankRef      String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  merchant Merchant      @relation(fields: [merchantId], references: [id])
  items    PayoutItem[]

  @@map("payouts")
}

model PayoutItem {
  id        String  @id @default(uuid()) @db.Uuid
  payoutId  String  @db.Uuid
  paymentId String  @db.Uuid
  amount    Decimal @db.Decimal(20, 4)
  fee       Decimal @default(0) @db.Decimal(20, 4)
  reserve   Decimal @default(0) @db.Decimal(20, 4)
  netAmount Decimal @db.Decimal(20, 4)
  description String?

  payout  Payout  @relation(fields: [payoutId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payout_items")
}

model FraudRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  condition   Json
  action      String   @default("DECLINE")
  scoreWeight Decimal  @default(10) @db.Decimal(5, 2)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fraud_rules")
}

model FraudEvent {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  ruleName  String?
  triggered Boolean
  score     Decimal  @db.Decimal(5, 2)
  reason    String?
  details   Json?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("fraud_events")
}

model Dispute {
  id            String         @id @default(uuid()) @db.Uuid
  paymentId     String         @db.Uuid
  merchantId    String         @db.Uuid
  reason        String
  status        DisputeStatus  @default(RAISED)
  amount        Decimal        @db.Decimal(20, 4)
  evidence      Json?
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  payment  Payment  @relation(fields: [paymentId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([paymentId])
  @@map("disputes")
}

model WebhookEndpoint {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  url         String
  events      Json     @default("[]")
  secretHash  String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant   Merchant            @relation(fields: [merchantId], references: [id])
  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String        @id @default(uuid()) @db.Uuid
  endpointId  String        @db.Uuid
  paymentId   String        @db.Uuid
  payload     Json
  status      WebhookStatus @default(PENDING)
  attempts    Int           @default(0)
  maxRetries  Int           @default(5)
  nextRetryAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime      @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])
  payment  Payment         @relation(fields: [paymentId], references: [id])

  @@index([endpointId])
  @@index([status])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

model BankAccount {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @db.Uuid
  accountNumber    String
  ifsc             String
  bankName         String?
  accountHolder    String?
  isPrimary        Boolean  @default(false)
  verified         Boolean  @default(false)
  verificationRef  String?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("bank_accounts")
}

model TeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @db.Uuid
  email        String
  name         String?
  role         String   @default("DEVELOPER")
  status       String   @default("ACTIVE")
  invitedAt    DateTime?
  expiresAt    DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, email])
  @@map("team_members")
}

model MerchantSession {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @db.Uuid
  token        String   @unique
  deviceInfo   String?
  ip           String?
  isCurrent    Boolean  @default(true)
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([token])
  @@map("merchant_sessions")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @db.Uuid
  invoiceNumber String   @unique
  customerName  String
  customerEmail String?
  customerGstin String?
  status        String   @default("DRAFT")
  subtotal      Decimal  @db.Decimal(20, 4)
  taxAmount     Decimal  @default(0) @db.Decimal(20, 4)
  total         Decimal  @db.Decimal(20, 4)
  currency      String   @default("INR")
  dueDate       DateTime?
  issuedDate    DateTime?
  paidAt        DateTime?
  notes         String?
  lineItems     Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
  @@map("invoices")
}

model Upload {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @db.Uuid
  fileName   String
  fileType   String
  fileSize   Int
  storageKey String
  category   String   @default("KYC")
  refId      String?
  refType    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([refId, refType])
  @@map("uploads")
}

model SubMerchant {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String   @db.Uuid
  name         String
  email        String
  commissionPct Decimal @default(0) @db.Decimal(5, 2)
  status       String   @default("ACTIVE")
  kycStatus    KYCStatus @default(NOT_SUBMITTED)
  riskCategory RiskCategory? @default(LOW)
  riskScore    Decimal? @default(0) @db.Decimal(5, 2)
  apiKeyPrefix String?
  gmv          Decimal  @default(0) @db.Decimal(20, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent           Merchant           @relation(fields: [parentId], references: [id])
  splitTransactions SplitTransaction[]

  @@index([parentId])
  @@map("sub_merchants")
}

model NotificationPreference {
  id         String  @id @default(uuid()) @db.Uuid
  merchantId String  @db.Uuid
  channel    String
  event      String
  enabled    Boolean @default(true)
  slackWebhook String?
  slackChannel String?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, channel, event])
  @@map("notification_preferences")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  key         String
  requestHash String
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model MerchantApproval {
  id          String       @id @default(uuid()) @db.Uuid
  merchantId  String       @db.Uuid
  action      String
  fromStatus  MerchantStatus
  toStatus    MerchantStatus
  reviewerId  String?
  reason      String?
  notes       String?
  createdAt   DateTime     @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("merchant_approvals")
}

model ComplianceNote {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @db.Uuid
  authorId   String?
  content    String
  category   String   @default("GENERAL")
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("compliance_notes")
}

model ReserveConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  merchantId            String   @unique @db.Uuid
  reservePercentage     Decimal  @default(10) @db.Decimal(5, 2)
  fixedReserveAmount    Decimal  @default(0) @db.Decimal(20, 4)
  releaseDelayDays      Int      @default(90)
  riskBasedIncrease     Boolean  @default(false)
  manualHold            Boolean  @default(false)
  manualHoldAmount      Decimal? @db.Decimal(20, 4)
  manualHoldReason      String?
  currentReserveBalance Decimal  @default(0) @db.Decimal(20, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  releases ReserveRelease[]

  @@map("reserve_configs")
}

model ReserveRelease {
  id              String   @id @default(uuid()) @db.Uuid
  configId        String   @db.Uuid
  amount          Decimal  @db.Decimal(20, 4)
  status          String   @default("PENDING")
  scheduledDate   DateTime
  releasedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime @default(now())

  config ReserveConfig @relation(fields: [configId], references: [id])

  @@index([configId])
  @@map("reserve_releases")
}

model SupportTicket {
  id            String         @id @default(uuid()) @db.Uuid
  merchantId    String         @db.Uuid
  subject       String
  category      TicketCategory @default(GENERAL)
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  assignedTo    String?
  slaDeadline   DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  messages TicketMessage[]

  @@index([merchantId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model TicketMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String?
  authorType String   @default("MERCHANT")
  content    String
  attachments Json?
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("ticket_messages")
}

model MerchantPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  tier          PlanTier @default(STARTER)
  description   String?
  monthlyPrice  Decimal  @db.Decimal(20, 4)
  transactionFee Decimal @db.Decimal(5, 4)
  fixedFee      Decimal  @default(0) @db.Decimal(20, 4)
  internationalMarkup Decimal @default(0) @db.Decimal(5, 4)
  maxMonthlyVolume Decimal? @db.Decimal(20, 4)
  maxApiCalls   Int?
  teamMembers   Int?
  features      Json     @default("[]")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@map("merchant_plans")
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  merchantId    String             @db.Uuid
  planId        String             @db.Uuid
  status        SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime       @default(now())
  currentPeriodEnd   DateTime
  canceledAt    DateTime?
  trialEndsAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  merchant Merchant   @relation(fields: [merchantId], references: [id])
  plan     MerchantPlan @relation(fields: [planId], references: [id])
  invoices BillingInvoice[]

  @@unique([merchantId])
  @@map("subscriptions")
}

model BillingInvoice {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  invoiceNumber  String       @unique
  amount         Decimal      @db.Decimal(20, 4)
  taxAmount      Decimal      @default(0) @db.Decimal(20, 4)
  total          Decimal      @db.Decimal(20, 4)
  currency       String       @default("INR")
  status         String       @default("PENDING")
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  paidVia        String?
  createdAt      DateTime     @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([status])
  @@map("billing_invoices")
}

model FeeSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  merchantId        String   @unique @db.Uuid
  mdr               Decimal  @default(2.9) @db.Decimal(5, 4)
  fixedFee          Decimal  @default(0.30) @db.Decimal(20, 4)
  internationalMarkup Decimal @default(1.5) @db.Decimal(5, 4)
  payoutFee         Decimal  @default(0) @db.Decimal(20, 4)
  refundFee         Decimal  @default(0) @db.Decimal(20, 4)
  chargebackFee     Decimal  @default(15) @db.Decimal(20, 4)
  upiMdr            Decimal  @default(0) @db.Decimal(5, 4)
  upiFixedFee       Decimal  @default(0) @db.Decimal(20, 4)
  planTier          PlanTier @default(STARTER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("fee_schedules")
}

model ReconciliationRun {
  id              String   @id @default(uuid()) @db.Uuid
  runType         String   @default("DAILY")
  status          String   @default("RUNNING")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  totalSource     Int      @default(0)
  totalTarget     Int      @default(0)
  matchedCount    Int      @default(0)
  driftedCount    Int      @default(0)
  missingCount    Int      @default(0)
  duplicateCount  Int      @default(0)
  orphanCount     Int      @default(0)
  autoCorrected   Int      @default(0)
  errors          Json?
  summary         Json?

  matches ReconciliationMatch[]

  @@map("reconciliation_runs")
}

model ReconciliationRule {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  description     String?
  matchType       String   @default("EXACT")         // EXACT, TOLERANCE, DATE_WINDOW
  sourceType      String   @default("PAYMENT")       // PAYMENT, SETTLEMENT, PAYOUT
  targetType      String   @default("LEDGER")        // LEDGER, SETTLEMENT, BANK
  amountTolerance Decimal  @default(0.01) @db.Decimal(20, 4)
  dateWindowHours Int      @default(48)
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("reconciliation_rules")
}

model ReconciliationMatch {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @db.Uuid
  matchType       String                         // MATCHED, DRIFTED, MISSING, DUPLICATE, ORPHAN
  sourceType      String                         // PAYMENT, LEDGER, SETTLEMENT
  sourceId        String?                        // payment/ledger/settlement ID
  targetType      String?                        // PAYMENT, LEDGER, SETTLEMENT
  targetId        String?                        // matched target ID
  expectedAmount  Decimal  @db.Decimal(20, 4)
  actualAmount    Decimal? @db.Decimal(20, 4)
  difference      Decimal  @default(0) @db.Decimal(20, 4)
  currency        String   @default("USD")
  description     String?
  status          String   @default("OPEN")      // OPEN, RESOLVED, ESCALATED, IGNORED
  resolution      String?
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  run ReconciliationRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([matchType])
  @@index([sourceType, sourceId])
  @@index([status])
  @@map("reconciliation_matches")
}

model SettlementBatch {
  id           String   @id @default(uuid()) @db.Uuid
  reference    String   @unique
  description  String?
  totalAmount  Decimal  @db.Decimal(20, 4)
  currency     String   @default("USD")
  itemCount    Int      @default(0)
  matchedCount Int      @default(0)
  status       String   @default("PENDING")     // PENDING, RECONCILED, PARTIAL, DISPUTED
  importedAt   DateTime @default(now())
  reconciledAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items SettlementBatchItem[]

  @@map("settlement_batches")
}

model SettlementBatchItem {
  id          String   @id @default(uuid()) @db.Uuid
  batchId     String   @db.Uuid
  paymentId   String?  @db.Uuid
  amount      Decimal  @db.Decimal(20, 4)
  currency    String   @default("USD")
  reference   String?
  description String?
  status      String   @default("PENDING")      // PENDING, MATCHED, UNMATCHED, DISPUTED
  matchedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch   SettlementBatch @relation(fields: [batchId], references: [id])
  payment Payment?        @relation(fields: [paymentId], references: [id])

  @@index([batchId])
  @@index([paymentId])
  @@index([status])
  @@map("settlement_batch_items")
}

model DailyBalance {
  id              String   @id @default(uuid()) @db.Uuid
  merchantId      String   @db.Uuid
  currency        String
  date            DateTime
  openingBalance  Decimal  @db.Decimal(20, 4)
  closingBalance  Decimal  @db.Decimal(20, 4)
  totalCredits    Decimal  @default(0) @db.Decimal(20, 4)
  totalDebits     Decimal  @default(0) @db.Decimal(20, 4)
  paymentCount    Int      @default(0)
  settlementCount Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([merchantId, currency, date])
  @@map("daily_balances")
}

model Incident {
  id            String           @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  severity      IncidentSeverity @default(SEV3)
  status        IncidentStatus   @default(DETECTED)
  affectedServices Json           @default("[]")
  detectedAt    DateTime         @default(now())
  acknowledgedAt DateTime?
  mitigatedAt   DateTime?
  resolvedAt    DateTime?
  rootCause     String?
  impact        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  updates IncidentUpdate[]

  @@map("incidents")
}

model IncidentUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @db.Uuid
  message     String
  status      String
  createdBy   String?
  createdAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@map("incident_updates")
}

model AdminActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

model SecurityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String?  @db.Uuid
  type       String
  severity   String   @default("INFO")
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([merchantId])
  @@index([type])
  @@index([createdAt])
  @@map("security_events")
}

model SplitTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  paymentId    String    @db.Uuid
  subMerchantId String   @db.Uuid
  splitType    SplitType @default(PERCENTAGE)
  splitValue   Decimal   @db.Decimal(20, 4)
  amount       Decimal   @db.Decimal(20, 4)
  status       String    @default("PENDING")
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())

  payment    Payment    @relation(fields: [paymentId], references: [id])
  subMerchant SubMerchant @relation(fields: [subMerchantId], references: [id])

  @@index([paymentId])
  @@index([subMerchantId])
  @@map("split_transactions")
}

model CannedResponse {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("canned_responses")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        String   @default("PENDING")
  retryCount    Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
  @@index([eventType])
  @@map("outbox_events")
}

model RateLimit {
  id        String   @id @default(uuid()) @db.Uuid
  ip        String
  endpoint  String
  count     Int      @default(1)
  windowStart DateTime @default(now())
  blockedUntil DateTime?

  @@index([ip, endpoint])
  @@index([blockedUntil])
  @@map("rate_limits")
}

model LedgerAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  requestedBy String
  approvedBy  String?
  accountId   String   @db.Uuid
  amount      Decimal  @db.Decimal(20, 4)
  type        EntryType
  reason      String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ledger_adjustments")
}

model ChartAccount {
  code        String       @id
  name        String
  type        AccountType
  category    String
  currency    String       @default("USD")
  isActive    Boolean      @default(true)
  description String?
  parentCode  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent         ChartAccount?         @relation("AccountHierarchy", fields: [parentCode], references: [code])
  children       ChartAccount[]        @relation("AccountHierarchy")
  journalLines   JournalLine[]
  accountBalances LedgerAccountBalance[]

  @@map("chart_accounts")
}

model JournalEntry {
  id               String        @id @default(uuid()) @db.Uuid
  transactionId    String?
  transactionType  String?
  description      String?
  reference        String?
  entryDate        DateTime      @default(now())
  status           JournalStatus @default(POSTED)
  createdById      String?
  reversalOfId     String?       @unique @db.Uuid
  reversalReason   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lines       JournalLine[]  @relation("JournalEntryLines")
  reversalOf  JournalEntry?  @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversals   JournalEntry[] @relation("EntryReversal")

  @@index([transactionId])
  @@index([transactionType])
  @@index([entryDate])
  @@index([status])
  @@map("journal_entries")
}

model JournalLine {
  id          String   @id @default(uuid()) @db.Uuid
  entryId     String   @db.Uuid
  accountCode String
  debit       Decimal  @default(0) @db.Decimal(20, 4)
  credit      Decimal  @default(0) @db.Decimal(20, 4)
  currency    String   @default("USD")
  description String?
  createdAt   DateTime @default(now())

  entry   JournalEntry @relation("JournalEntryLines", fields: [entryId], references: [id])
  account ChartAccount @relation(fields: [accountCode], references: [code])

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_lines")
}

model LedgerAccountBalance {
  id          String   @id @default(uuid()) @db.Uuid
  accountCode String
  currency    String   @default("USD")
  balance     Decimal  @default(0) @db.Decimal(20, 4)
  periodStart DateTime @default(now())
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account ChartAccount @relation(fields: [accountCode], references: [code])

  @@unique([accountCode, currency, periodStart, periodEnd])
  @@index([accountCode, periodEnd])
  @@map("ledger_account_balances")
}
