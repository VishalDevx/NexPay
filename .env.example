# Database
DATABASE_URL=postgresql://nexpay:nexpay@localhost:5432/nexpay?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-in-prod

# JWT
JWT_SECRET=your-jwt-secret-change-in-prod

# Server
PORT=3001
NODE_ENV=development

# FX API (free tier: exchangerate-api.com)
FX_API_URL=https://api.exchangerate-api.com/v4/latest/USD
FX_API_KEY=

# SMTP (for merchant notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
