# ──────────────────────────────────────────
# NexPay Environment Configuration
# ──────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Server ──
NODE_ENV=development
PORT=3001

# ── Database ──
DATABASE_URL=postgresql://nexpay:nexpay@localhost:5432/nexpay?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Secrets (min 16 chars each) ──
JWT_SECRET=change-this-to-a-random-32-char-string
ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# ── FX Rates (optional) ──
FX_API_URL=https://api.exchangerate-api.com/v4/latest/USD
FX_API_KEY=

# ── Email (Resend) ──
# Sign up at https://resend.com
RESEND_API_KEY=

# ── Development only ──
# When true, OTP verification accepts code "000000" for any email
BYPASS_OTP=false
